# Copy this file to .env and set your database connection
NODE_ENV=production
PORT=3000
JWT_SECRET=change-me-to-a-long-random-secret
FRONTEND_ORIGINS=https://yousifahmed249.github.io

# Local PostgreSQL via Docker
POSTGRES_DB=inventory_db
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=inventory_pass
DATABASE_URL=postgresql://inventory_user:inventory_pass@localhost:5432/inventory_db

# Production / hosted PostgreSQL example:
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
